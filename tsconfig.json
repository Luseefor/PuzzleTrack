{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "extension/dist",
    "rootDir": ".",
    "types": [
      "chrome",
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "extension/src/**/*",
    "extension/tests/**/*",
    "scripts/**/*",
    "vitest.config.ts"
  ]
}
